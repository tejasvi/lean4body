import C4Check

/-! Cells `25090 ≤ n < 25093` of `dirCell`: `decide +kernel` checks that `checkBoxH` succeeds on each
with its hint. -/

set_option Elab.async false

namespace C4.Cert.Dir071

theorem c0 : allCells dirCell 25090 25091 [
    ] = true := by
  decide +kernel

theorem c1 : allCells dirCell 25091 25092 [
    ] = true := by
  decide +kernel

theorem c2 : allCells dirCell 25092 25093 [
    ] = true := by
  decide +kernel

theorem cover : Cover dirCell 25090 25093 :=
  (allCells_cover c0).trans <|
    (allCells_cover c1).trans <|
    allCells_cover c2

end C4.Cert.Dir071
