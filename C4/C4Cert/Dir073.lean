import C4Check

/-! Cells `25146 ≤ n < 25150` of `dirCell`: `decide +kernel` checks that `checkBoxH` succeeds on each
with its hint. -/

set_option Elab.async false

namespace C4.Cert.Dir073

theorem c0 : allCells dirCell 25146 25147 [
    ] = true := by
  decide +kernel

theorem c1 : allCells dirCell 25147 25148 [
    ] = true := by
  decide +kernel

theorem c2 : allCells dirCell 25148 25149 [
    ] = true := by
  decide +kernel

theorem c3 : allCells dirCell 25149 25150 [
    ] = true := by
  decide +kernel

theorem cover : Cover dirCell 25146 25150 :=
  (allCells_cover c0).trans <|
    (allCells_cover c1).trans <|
    (allCells_cover c2).trans <|
    allCells_cover c3

end C4.Cert.Dir073
