import C4Check

/-! Cells `21955 ≤ n < 21958` of `dirCell`: `decide +kernel` checks that `checkBoxH` succeeds on each
with its hint. -/

set_option Elab.async false

namespace C4.Cert.Dir048

theorem c0 : allCells dirCell 21955 21956 [
    ] = true := by
  decide +kernel

theorem c1 : allCells dirCell 21956 21957 [
    ] = true := by
  decide +kernel

theorem c2 : allCells dirCell 21957 21958 [
    ] = true := by
  decide +kernel

theorem cover : Cover dirCell 21955 21958 :=
  (allCells_cover c0).trans <|
    (allCells_cover c1).trans <|
    allCells_cover c2

end C4.Cert.Dir048
