import C4Check

/-! Cells `23522 ≤ n < 23525` of `dirCell`: `decide +kernel` checks that `checkBoxH` succeeds on each
with its hint. -/

set_option Elab.async false

namespace C4.Cert.Dir059

theorem c0 : allCells dirCell 23522 23523 [
    ] = true := by
  decide +kernel

theorem c1 : allCells dirCell 23523 23524 [
    ] = true := by
  decide +kernel

theorem c2 : allCells dirCell 23524 23525 [
    ] = true := by
  decide +kernel

theorem cover : Cover dirCell 23522 23525 :=
  (allCells_cover c0).trans <|
    (allCells_cover c1).trans <|
    allCells_cover c2

end C4.Cert.Dir059
